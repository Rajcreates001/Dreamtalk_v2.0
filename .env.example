# ═══════════════════════════════════════════════════════════════════════
# DreamTalk v2.0 — Environment template
# Copy to `dreamtalk/.env` (and `dreamtalk/backend/.env`) and fill in.
# NEVER commit the filled-in files — they are gitignored on purpose.
# ═══════════════════════════════════════════════════════════════════════

# ── LLM providers ───────────────────────────────────────────────────────
# Primary brain for the 3D avatar (seekai.cc / claude-fable-5)
SEEKAI_BASE_URL=https://seekai.cc/v1
SEEKAI_MODEL=claude-fable-5
SEEKAI_API_KEY=<ask project owner for the key>

# gpt-oss 120B on the external GPU vLLM server (fallback #1)
GPTOSS_BASE_URL=http://144.79.62.242:8002/v1
GPTOSS_MODEL=gpt-oss-120b-coding
GPU_SERVER_API_KEY=

# Local Ollama (fallback #2) — expects llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<local postgres password>
DB_NAME=dream_talk_db

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=<generate: python -c "import secrets; print(secrets.token_hex(32))">
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Redis / Celery ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Weaviate ────────────────────────────────────────────────────────────
WEAVIATE_URL=http://localhost:8080

# ── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_WS_URL=ws://localhost:5001
