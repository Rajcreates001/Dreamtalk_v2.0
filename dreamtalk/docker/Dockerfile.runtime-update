# Fast, non-destructive dependency overlay for an existing DreamTalk GPU image.
# The canonical clean build remains docker/Dockerfile; this target avoids
# reinstalling CUDA and Python when updating a running developer workstation.
FROM dreamtalk-backend:latest

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends libegl1 libgles2 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-ml.txt /tmp/requirements-ml.txt
COPY requirements-face.txt /tmp/requirements-face.txt
COPY requirements-voice.txt /tmp/requirements-voice.txt

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install "numpy>=1.24,<2.0" && \
    pip install --no-build-isolation --no-deps "basicsr==1.4.2" && \
    pip install --force-reinstall --no-deps blinker && \
    pip install -r /tmp/requirements-face.txt && \
    pip install -r /tmp/requirements-voice.txt && \
    pip uninstall -y gTTS

COPY . /app/dreamtalk/
WORKDIR /app
