# syntax=docker/dockerfile:1
# TripoSR — single image to 3D mesh, as its own service.
#
# Why a separate container: the reconstruction stack wants ~6GB of VRAM on a
# card that already holds vLLM (~3.7GB) and MuseTalk (~2GB). Isolating it
# means the orchestrator can start it, use it, and stop it around a build
# instead of trying to keep three models resident on 8GB.
#
# Licence: MIT for BOTH the source and the pretrained weights, which is the
# distinction that disqualified Hunyuan3D (Tencent non-commercial, and
# excluded in the EU/UK/KR) and PIFuHD (research-only terms).
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# devel, not runtime: torchmcubes compiles CUDA kernels at install time and
# needs nvcc. The runtime image has the libraries but not the compiler, and
# the failure surfaces late as a missing nvcc during pip install.

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models/huggingface \
    TORCH_CUDA_ARCH_LIST="8.9" \
    MESH3D_PORT=8003

# python3-dev and build-essential are required, not optional — the same
# omission cost two failed builds on the Indic-Mio image: cmake got the
# extension as far as compiling, then it died on a missing Python.h.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev python3-venv \
    git build-essential cmake ninja-build \
    libgl1 libglib2.0-0 curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --upgrade pip setuptools wheel && \
    pip install torch==2.5.1 torchvision --index-url https://download.pytorch.org/whl/cu124

# No commit pin: an invented SHA with `|| true` behind it is worse than
# no pin at all, because the build silently uses main while claiming to
# be reproducible. Record what was actually cloned instead.
RUN git clone --depth 1 https://github.com/VAST-AI-Research/TripoSR.git /opt/triposr && \
    git -C /opt/triposr rev-parse HEAD > /opt/triposr_commit.txt && \
    cat /opt/triposr_commit.txt

WORKDIR /opt/triposr

# torchmcubes has to be built against the torch that is already installed, and
# getting there takes three steps rather than one. The obvious single
# `pip install -r requirements.txt` fails twice over:
#
#  1. requirements.txt lists torchmcubes itself, and pip builds it in an
#     isolated environment that has no torch: "torchmcubes must be built
#     against an installed PyTorch". pip then abandons the whole resolve, so
#     *nothing* in the file gets installed - and with `|| true` behind it
#     that failure stays invisible until the service cannot import omegaconf.
#  2. Passing --no-build-isolation fixes the torch visibility and breaks the
#     build backend instead: "Cannot import 'scikit_build_core.build'",
#     because with isolation off the backend must already be present.
#
# So: strip torchmcubes out of the requirements, install the rest normally,
# install the build backend explicitly, then build torchmcubes against the
# installed torch. And no `|| true` - a silent partial install here surfaces
# much later as a runtime ImportError.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    grep -iv torchmcubes requirements.txt > /tmp/requirements.notorch.txt && \
    cat /tmp/requirements.notorch.txt && \
    pip install -r /tmp/requirements.notorch.txt

# torchmcubes asks for C++20 and cannot be compiled with it. Its
# helper_math.h declares a global `lerp`, C++20 puts std::lerp in scope
# beside it, and nvcc's host pass dies with
#   error: 'float lerp(float, float, float)' conflicts with a previous
#   declaration
# after five minutes of compiling. Passing -DCMAKE_CXX_STANDARD=17 does not
# help: it reaches the cache and the project's own CMakeLists overrides it,
# so the standard has to be changed at the source. torch 2.5 is a C++17
# build, so this moves the extension onto the same standard as the library
# it links against rather than away from it.
#
# CMAKE_CUDA_ARCHITECTURES=89 is the card this runs on (RTX 4060, capability
# 8.9). Without it the kernels are built for every architecture the toolkit
# knows, which is most of those five minutes.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install "scikit-build-core>=0.10" "cmake>=3.24" ninja pybind11 && \
    git clone --depth 1 https://github.com/tatsy/torchmcubes.git /opt/torchmcubes && \
    sed -i -E 's/(CXX_STANDARD|CUDA_STANDARD)([ ]+)20/\1\217/g; s/(cxx_std_|cuda_std_)20/\117/g' \
      /opt/torchmcubes/CMakeLists.txt /opt/torchmcubes/cxx/CMakeLists.txt 2>/dev/null || true && \
    grep -rniE 'std_|_STANDARD' /opt/torchmcubes/CMakeLists.txt /opt/torchmcubes/cxx/CMakeLists.txt || true

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    CMAKE_PREFIX_PATH="$(python -c 'import pybind11, torch; print(pybind11.get_cmake_dir() + chr(58) + torch.utils.cmake_prefix_path)')" \
    CMAKE_ARGS="-DCMAKE_CUDA_ARCHITECTURES=89" \
    pip install --no-build-isolation /opt/torchmcubes

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install fastapi "uvicorn[standard]" python-multipart trimesh

# Fail the build here rather than at the first reconstruction. An image that
# starts, answers /health, and then cannot import its own CUDA extension is
# the exact failure mode this project keeps hitting: a green healthcheck
# beside a capability that does not work.
RUN python -c "import torch, torchmcubes, trimesh, rembg, omegaconf; \
    from torchmcubes import marching_cubes; \
    print('torch', torch.__version__, 'torchmcubes OK')"

COPY docker/mesh3d_server.py /opt/mesh3d_server.py

EXPOSE 8003
HEALTHCHECK --interval=30s --timeout=10s --start-period=240s --retries=5 \
    CMD curl --fail http://localhost:8003/health || exit 1

CMD ["python", "/opt/mesh3d_server.py"]
