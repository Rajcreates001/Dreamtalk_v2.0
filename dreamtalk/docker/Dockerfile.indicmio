# syntax=docker/dockerfile:1
FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04

ARG MIOTTS_INFERENCE_COMMIT=2763e0910b251510c6b6a432e5f605d57c5e7ff5

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models/huggingface \
    MIOTTS_DEVICE=cuda

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv git ffmpeg libsndfile1 curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --upgrade pip setuptools wheel && \
    pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu129

ARG MIOCODEC_COMMIT=77473544375d57e96cbdfd5d7d257e8f280fa8e3

RUN git clone https://github.com/Aratako/MioTTS-Inference.git /opt/miotts && \
    cd /opt/miotts && git checkout "${MIOTTS_INFERENCE_COMMIT}" && \
    pip install --no-cache-dir \
      "git+https://github.com/Aratako/MioCodec.git@${MIOCODEC_COMMIT}" \
      "accelerate>=1.12.0" "fastapi>=0.111.0" "gradio>=4.0.0" \
      "httpx>=0.27.0" g2p_en nltk pyopenjtalk \
      "python-multipart>=0.0.9" soundfile "transformers<5" \
      "uvicorn>=0.30.0" "ninja>=1.13.0"

WORKDIR /opt/miotts
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD curl --fail http://localhost:8001/health || exit 1

CMD ["python", "run_server.py", "--host", "0.0.0.0", "--port", "8001"]
