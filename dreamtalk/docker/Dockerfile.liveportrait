# syntax=docker/dockerfile:1
# ============================================================================
# LivePortrait Face Animation Microservice — Standalone Docker image
#
# This image runs the LivePortrait face animation engine as a standalone
# process. It uses CPU-only PyTorch to avoid GPU/CUDA conflicts and keep
# the image portable. Weights are mounted as a volume at runtime.
#
# Build:
#   docker build -t dreamtalk-liveportrait -f docker/Dockerfile.liveportrait .
#
# Run:
#   docker run -d --name liveportrait \
#     -p 8003:8003 \
#     -v D:/dreamtalk/weights:/app/weights \
#     dreamtalk-liveportrait
# ============================================================================

FROM python:3.11-slim

# ---- Build args ----------------------------------------------------------
ARG TORCH_VERSION=2.5.1
ARG TORCH_VISION_VERSION=0.20.1
ARG TORCH_AUDIO_VERSION=2.5.1

# ---- Environment ---------------------------------------------------------
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    KMP_DUPLICATE_LIB_OK=TRUE \
    DEBIAN_FRONTEND=noninteractive

# ---- System deps ---------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ---- Install PyTorch (CPU-only) ------------------------------------------
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-cache-dir \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCH_VISION_VERSION}" \
        "torchaudio==${TORCH_AUDIO_VERSION}" \
        --index-url https://download.pytorch.org/whl/cpu

# ---- Install LivePortrait dependencies -----------------------------------
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-cache-dir \
        "opencv-python-headless>=4.9.0" \
        "numpy<2.0.0" \
        "pyyaml>=6.0" \
        "timm>=0.9.0" \
        "rich>=13.0" \
        "scipy>=1.12.0" \
        "onnxruntime>=1.17.0"

# ---- Copy application code -----------------------------------------------
# LivePortrait face animation engine
COPY dreamtalk/face/core/animation/liveportrait/ /app/dreamtalk/face/core/animation/liveportrait/
COPY dreamtalk/face/core/animation/__init__.py   /app/dreamtalk/face/core/animation/__init__.py
COPY dreamtalk/face/core/__init__.py             /app/dreamtalk/face/core/__init__.py
COPY dreamtalk/face/__init__.py                  /app/dreamtalk/face/__init__.py

# Pipeline animation wrapper (uses the same LivePortrait engine)
COPY dreamtalk/pipeline/animation_pipeline.py    /app/dreamtalk/pipeline/animation_pipeline.py
COPY dreamtalk/pipeline/__init__.py              /app/dreamtalk/pipeline/__init__.py

# package scaffolding
COPY dreamtalk/__init__.py                       /app/dreamtalk/__init__.py

RUN mkdir -p /app/dreamtalk/face/core && touch /app/dreamtalk/face/core/__init__.py && \
    mkdir -p /app/dreamtalk/face && touch /app/dreamtalk/face/__init__.py

WORKDIR /app

EXPOSE 8003

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import os; assert os.path.exists('/app/weights/liveportrait/appearance_feature_extractor.pth')" || exit 1

# Default: just check the import works, then sleep
# Override command: python face/core/animation/liveportrait/liveportrait_venv_runner.py --source ... --driving ... --output ...
CMD ["python", "-c", "print('LivePortrait Docker image ready. Use docker exec or override CMD to run animation.'); import sys; sys.stdout.flush()"]
