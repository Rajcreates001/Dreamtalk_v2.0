# ============================================================
# DreamTalk — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=dream_talk_db
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Weaviate (Vector DB) ───────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# ── LLM Backend ────────────────────────────────────────────
GPU_SERVER_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=deepseek-r1:7b
LLM_BACKEND=ollama
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ── JWT / Auth ─────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ── TTS Output ─────────────────────────────────────────────
TTS_OUTPUT_DIR=/app/dreamtalk/pipeline_outputs/tts

# ── IndicF5 Microservice ───────────────────────────────────
INDICF5_WEIGHTS_DIR=/app/weights/voice/indic_tts/IndicF5
INDICF5_PORT=8002

# ── GPU / ML ───────────────────────────────────────────────
TF_ENABLE_ONEDNN_OPTS=0
KMP_DUPLICATE_LIB_OK=TRUE
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ── Frontend ────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_WS_URL=ws://localhost:5001

# ── Docker Ports (override defaults) ───────────────────────
BACKEND_PORT=5001
FRONTEND_PORT=4000
POSTGRES_PORT=5433
REDIS_PORT=6380
WEAVIATE_PORT=8081

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
